# Server
PORT=3001
# "production" also starts the birthday/event reminder cron.
NODE_ENV=development
# Allowed browser origin(s). Comma-separated for more than one.
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used by the keep-alive cron).
SELF_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/shamak

# Auth secrets — REQUIRED in production. Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ImageKit (chat media)
IMAGEKIT_PRIVATE_KEY=private_xxx

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:family@shamak.app
